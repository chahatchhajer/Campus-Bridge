# ---------- Server environment (BACKEND ONLY: never copy these into client/.env or any VITE_* variable) ----------

NODE_ENV=development
PORT=4000

# Supabase Postgres connection string (Project Settings > Database > Connection string).
# Use the "Session pooler" string on Render (IPv4 compatible). SSL is enabled automatically for non-localhost hosts.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/campus_bridge

# Exact frontend origin(s) allowed by CORS, comma separated, no trailing slash. REQUIRED in production.
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase Auth + Storage ---
# Project URL, e.g. https://abcdefgh.supabase.co  (used to verify JWTs via the project's JWKS and for Storage)
SUPABASE_URL=
# Service-role key: bypasses RLS. Backend only. Used for private Storage and optional account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if your project still signs tokens with the legacy shared JWT secret (HS256).
# Leave empty when the project uses the newer asymmetric signing keys.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=resumes

# --- Local review only ---
# DEMO_MODE=true bypasses authentication: every visitor shares one fixed demo account. NOT SECURE.
# The server refuses to start with it in production unless ALLOW_PUBLIC_DEMO=true is also set.
DEMO_MODE=false

# Optional: enables GET /api/health/ready (database/storage/auth diagnostics) when sent as the x-health-token header.
HEALTH_CHECK_TOKEN=

# Local-dev storage fallback (only used when SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are unset and NODE_ENV != production)
LOCAL_STORAGE_DIR=.data/uploads
