# ---------- Client environment (PUBLIC: everything here is embedded in the browser bundle) ----------
# Never put database URLs, service-role keys, JWT secrets or storage credentials in a VITE_* variable.

# Base URL of the Express API. Leave empty in local development (Vite proxies /api to http://localhost:4000).
# On Vercel set it to your Render service URL, e.g. https://campus-bridge-api.onrender.com
VITE_API_URL=

# Supabase Auth (public values): Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local visual review only: skips sign-in and talks to a server running with DEMO_MODE=true. NOT SECURE.
VITE_DEMO_MODE=false
